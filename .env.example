# =============================================================================
# SwiftRoute Last-Mile · Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y reemplaza los placeholders con tus credenciales
# =============================================================================

# 1. PostgreSQL
POSTGRES_USER=<CHANGE_ME_DB_USER>
POSTGRES_PASSWORD=<CHANGE_ME_DB_PASSWORD>
POSTGRES_DB=swiftroute
DATABASE_URL=postgres://<CHANGE_ME_DB_USER>:<CHANGE_ME_DB_PASSWORD>@postgres:5432/swiftroute
SWIFTROUTE_DB_URL=postgresql://<CHANGE_ME_DB_USER>:<CHANGE_ME_DB_PASSWORD>@postgres:5432/swiftroute

# 2. Apache Kafka (KRaft)
KAFKA_BROKERS=kafka:29092

# 3. Core API & Stream Processor (Rust)
RUST_LOG=info
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
MAX_TRACKED_DRIVERS=500
SWIFTROUTE_API_KEY=<CHANGE_ME_API_KEY>

# 4. Apache Airflow & Reverse Proxy Injection
AIRFLOW_ADMIN_USER=<CHANGE_ME_AIRFLOW_USER>
AIRFLOW_ADMIN_PASSWORD=<CHANGE_ME_AIRFLOW_PASSWORD>
AIRFLOW_ADMIN_EMAIL=admin@swiftroute.local
AIRFLOW_BASIC_AUTH_B64=<BASE64_OF_USER_COLON_PASSWORD>
AIRFLOW_SECRET_KEY=<CHANGE_ME_64_HEX_SECRET_KEY>
AIRFLOW_SQLALCHEMY_CONN=postgresql+psycopg2://<CHANGE_ME_DB_USER>:<CHANGE_ME_DB_PASSWORD>@postgres:5432/swiftroute
